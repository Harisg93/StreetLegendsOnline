  <script>
    /* ==========================================================================
       1. GAME STATE & AUDIO
       ========================================================================== */
    const keys = { w: false, s: false, a: false, d: false, space: false, shift: false };
    let garageOpen = false;

    // Web Audio für Motorsound & Effekte
    let audioCtx = null;
    let engineOsc = null;
    let engineGain = null;
    let skidGain = null;

    function initAudio() {
      if (audioCtx) return;
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      
      // Motor Oscillator
      engineOsc = audioCtx.createOscillator();
      engineOsc.type = 'sawtooth';
      engineGain = audioCtx.createGain();
      engineGain.gain.setValueAtTime(0.04, audioCtx.currentTime);
      
      const filter = audioCtx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(800, audioCtx.currentTime);

      engineOsc.connect(filter);
      filter.connect(engineGain);
      engineGain.connect(audioCtx.destination);
      engineOsc.start();

      // Reifenquietschen Noise
      const bufferSize = audioCtx.sampleRate * 2;
      const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
      const output = noiseBuffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        output[i] = Math.random() * 2 - 1;
      }
      const whiteNoise = audioCtx.createBufferSource();
      whiteNoise.buffer = noiseBuffer;
      whiteNoise.loop = true;

      const skidFilter = audioCtx.createBiquadFilter();
      skidFilter.type = 'bandpass';
      skidFilter.frequency.setValueAtTime(1400, audioCtx.currentTime);

      skidGain = audioCtx.createGain();
      skidGain.gain.setValueAtTime(0, audioCtx.currentTime);

      whiteNoise.connect(skidFilter);
      skidFilter.connect(skidGain);
      skidGain.connect(audioCtx.destination);
      whiteNoise.start();
    }

    /* ==========================================================================
       2. THREE.JS SCENE SETUP
       ========================================================================== */
    const container = document.getElementById('canvas-container');
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x060810);
    scene.fog = new THREE.FogExp2(0x060810, 0.0055);

    const camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    container.appendChild(renderer.domElement);

    // Beleuchtung
    const ambientLight = new THREE.AmbientLight(0x283244, 1.2);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xddeeff, 1.0);
    dirLight.position.set(60, 100, 40);
    dirLight.castShadow = true;
    dirLight.shadow.mapSize.width = 2048;
    dirLight.shadow.mapSize.height = 2048;
    dirLight.shadow.camera.near = 10;
    dirLight.shadow.camera.far = 300;
    dirLight.shadow.camera.left = -120;
    dirLight.shadow.camera.right = 120;
    dirLight.shadow.camera.top = 120;
    dirLight.shadow.camera.bottom = -120;
    scene.add(dirLight);

    /* ==========================================================================
       3. TRACK & CITY GENERATION
       ========================================================================== */
    // Rennstrecke als Spline-Pfad
    const trackPoints = [
      new THREE.Vector3(0, 0, 0),
      new THREE.Vector3(70, 0, 20),
      new THREE.Vector3(120, 0, 80),
      new THREE.Vector3(90, 0, 140),
      new THREE.Vector3(10, 0, 130),
      new THREE.Vector3(-40, 0, 170),
      new THREE.Vector3(-100, 0, 130),
      new THREE.Vector3(-110, 0, 50),
      new THREE.Vector3(-70, 0, -20),
      new THREE.Vector3(-20, 0, -50),
    ];
    const trackCurve = new THREE.CatmullRomCurve3(trackPoints, true);
    const trackSamples = trackCurve.getPoints(200);

    // Strecken-Geometrie aufbauen
    const trackWidth = 14;
    const trackShape = new THREE.Shape();
    trackShape.moveTo(-trackWidth / 2, 0);
    trackShape.lineTo(trackWidth / 2, 0);

    // Asphaltoberfläche
    const trackGeometry = new THREE.BufferGeometry();
    const verts = [];
    const uvs = [];
    const normals = [];

    for (let i = 0; i < trackSamples.length; i++) {
      const p1 = trackSamples[i];
      const p2 = trackSamples[(i + 1) % trackSamples.length];
      const forward = new THREE.Vector3().subVectors(p2, p1).normalize();
      const right = new THREE.Vector3(-forward.z, 0, forward.x).normalize();

      const leftPt = new THREE.Vector3().addVectors(p1, right.clone().multiplyScalar(-trackWidth / 2));
      const rightPt = new THREE.Vector3().addVectors(p1, right.clone().multiplyScalar(trackWidth / 2));

      verts.push(leftPt.x, 0.05, leftPt.z);
      verts.push(rightPt.x, 0.05, rightPt.z);

      normals.push(0, 1, 0);
      normals.push(0, 1, 0);
      uvs.push(0, i / trackSamples.length * 20);
      uvs.push(1, i / trackSamples.length * 20);
    }

    const indices = [];
    for (let i = 0; i < trackSamples.length; i++) {
      const currentLeft = i * 2;
      const currentRight = i * 2 + 1;
      const nextLeft = ((i + 1) % trackSamples.length) * 2;
      const nextRight = ((i + 1) % trackSamples.length) * 2 + 1;

      indices.push(currentLeft, nextLeft, currentRight);
      indices.push(currentRight, nextLeft, nextRight);
    }
    trackGeometry.setAttribute('position', new THREE.Float32BufferAttribute(verts, 3));
    trackGeometry.setAttribute('normal', new THREE.Float32BufferAttribute(normals, 3));
    trackGeometry.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
    trackGeometry.setIndex(indices);

    const roadMaterial = new THREE.MeshStandardMaterial({
      color: 0x181a20,
      roughness: 0.8,
      metalness: 0.2
    });
    const roadMesh = new THREE.Mesh(trackGeometry, roadMaterial);
    roadMesh.receiveShadow = true;
    scene.add(roadMesh);

    // Bodenplatte (Stadt-Terrain)
    const groundGeo = new THREE.PlaneGeometry(600, 600);
    const groundMat = new THREE.MeshStandardMaterial({ color: 0x090b10, roughness: 0.95 });
    const ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);

    // Gebäude und Straßenlaternen entlang der Strecke platzieren
    const buildingMat = new THREE.MeshStandardMaterial({ color: 0x141824, roughness: 0.7 });
    const windowMat = new THREE.MeshBasicMaterial({ color: 0x00f0ff });
    const neonColors = [0x00f0ff, 0xff0055, 0xb300ff, 0xffaa00];

    for (let i = 0; i < 90; i++) {
      const w = 12 + Math.random() * 15;
      const d = 12 + Math.random() * 15;
      const h = 25 + Math.random() * 60;
      const bGeo = new THREE.BoxGeometry(w, h, d);
      const bMesh = new THREE.Mesh(bGeo, buildingMat);

      // Zufällige Positionierung mit Mindestabstand zur Strecke
      let valid = false;
      let bx, bz;
      for (let attempt = 0; attempt < 10; attempt++) {
        bx = (Math.random() - 0.5) * 350;
        bz = (Math.random() - 0.5) * 350;
        let tooClose = false;
        for (let pt of trackPoints) {
          if (new THREE.Vector2(bx, bz).distanceTo(new THREE.Vector2(pt.x, pt.z)) < 22) {
            tooClose = true;
            break;
          }
        }
        if (!tooClose) { valid = true; break; }
      }
      if (valid) {
        bMesh.position.set(bx, h / 2, bz);
        bMesh.castShadow = true;
        bMesh.receiveShadow = true;
        scene.add(bMesh);

        // Neon Sign an einigen Gebäuden
        if (Math.random() > 0.4) {
          const signColor = neonColors[Math.floor(Math.random() * neonColors.length)];
          const sign = new THREE.Mesh(
            new THREE.BoxGeometry(w * 0.7, 2, 0.5),
            new THREE.MeshBasicMaterial({ color: signColor })
          );
          sign.position.set(bx, h - 4, bz + d / 2 + 0.3);
          scene.add(sign);
        }
      }
    }

    // Start-Ziel Tor
    const archMat = new THREE.MeshStandardMaterial({ color: 0x333b4d });
    const archP1 = new THREE.Mesh(new THREE.BoxGeometry(1, 6, 1), archMat);
    const archP2 = new THREE.Mesh(new THREE.BoxGeometry(1, 6, 1), archMat);
    const archTop = new THREE.Mesh(new THREE.BoxGeometry(16, 1.2, 1.5), new THREE.MeshBasicMaterial({ color: 0xff0055 }));
    archP1.position.set(-8, 3, 0);
    archP2.position.set(8, 3, 0);
    archTop.position.set(0, 6, 0);
    const startFinishGate = new THREE.Group();
    startFinishGate.add(archP1, archP2, archTop);
    scene.add(startFinishGate);

    /* ==========================================================================
       4. CAR CREATION (PLAYER & AI)
       ========================================================================== */
    function createCarMesh(bodyColorHex, underglowHex) {
      const carGroup = new THREE.Group();

      // Hauptkarosserie
      const bodyMat = new THREE.MeshStandardMaterial({
        color: bodyColorHex,
        metalness: 0.7,
        roughness: 0.2
      });
      const body = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.7, 4.3), bodyMat);
      body.position.y = 0.55;
      body.castShadow = true;
      carGroup.add(body);

      // Kabine / Scheiben
      const cabinMat = new THREE.MeshStandardMaterial({ color: 0x05070a, roughness: 0.1 });
      const cabin = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.55, 2.1), cabinMat);
      cabin.position.set(0, 1.05, -0.2);
      cabin.castShadow = true;
      carGroup.add(cabin);

      // Spoiler
      const spoilerMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.4 });
      const spoilerWing = new THREE.Mesh(new THREE.BoxGeometry(2.1, 0.08, 0.5), spoilerMat);
      spoilerWing.position.set(0, 1.2, -1.9);
      const post1 = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.4, 0.1), spoilerMat);
      const post2 = post1.clone();
      post1.position.set(-0.7, 1.0, -1.9);
      post2.position.set(0.7, 1.0, -1.9);
      carGroup.add(spoilerWing, post1, post2);

      // Räder
      const wheelMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.8 });
      const rimMat = new THREE.MeshStandardMaterial({ color: 0xcccccc, metalness: 0.8 });
      const wheelPositions = [
        [-1.05, 0.35, 1.3],
        [1.05, 0.35, 1.3],
        [-1.05, 0.35, -1.3],
        [1.05, 0.35, -1.3]
      ];
      wheelPositions.forEach(pos => {
        const wGroup = new THREE.Group();
        const tire = new THREE.Mesh(new THREE.CylinderGeometry(0.38, 0.38, 0.35, 16), wheelMat);
        tire.rotation.z = Math.PI / 2;
        tire.castShadow = true;
        const rim = new THREE.Mesh(new THREE.CylinderGeometry(0.24, 0.24, 0.36, 8), rimMat);
        rim.rotation.z = Math.PI / 2;
        wGroup.add(tire, rim);
        wGroup.position.set(...pos);
        carGroup.add(wGroup);
      });

      // Front- und Rücklichter
      const headL = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.15, 0.1), new THREE.MeshBasicMaterial({ color: 0xddeeff }));
      headL.position.set(-0.7, 0.6, 2.15);
      const headR = headL.clone(); headR.position.x = 0.7;
      const tailL = new THREE.Mesh(new THREE.BoxGeometry(0.4, 0.15, 0.1), new THREE.MeshBasicMaterial({ color: 0xff0033 }));
      tailL.position.set(-0.7, 0.6, -2.15);
      const tailR = tailL.clone(); tailR.position.x = 0.7;
      carGroup.add(headL, headR, tailL, tailR);

      // Neon-Underglow
      const underglowLight = new THREE.PointLight(underglowHex, 2.2, 5.5);
      underglowLight.position.set(0, 0.15, 0);
      carGroup.add(underglowLight);

      return { mesh: carGroup, bodyMaterial: bodyMat, underglowLight: underglowLight };
    }

    // Spieler-Fahrzeug
    const playerCarData = createCarMesh(0x00f0ff, 0x00f0ff);
    const player = {
      mesh: playerCarData.mesh,
      bodyMat: playerCarData.bodyMaterial,
      underglow: playerCarData.underglowLight,
      pos: new THREE.Vector3(0, 0, 0),
      rotY: 0,
      velocity: new THREE.Vector3(),
      speed: 0,
      turnAngle: 0,
      driftFactor: 0.91,
      maxSpeed: 0.95,
      accel: 0.016,
      nitro: 100,
      isDrifting: false,
      lap: 1,
      lastCheckpoint: 0,
      lapStartTime: performance.now(),
      bestLapTime: null
    };
    scene.add(player.mesh);

    // KI-Gegner
    const aiCars = [
      { name: 'NightWolf', color: 0xff0055, speedOffset: 0.88, offsetTrack: -3.5, splineT: 0.05 },
      { name: 'DriftKing', color: 0x9900ff, speedOffset: 0.84, offsetTrack: 3.5, splineT: 0.02 },
      { name: 'CyberPhantom', color: 0xffaa00, speedOffset: 0.81, offsetTrack: 0.0, splineT: 0.08 }
    ];
    aiCars.forEach(ai => {
      const data = createCarMesh(ai.color, ai.color);
      ai.mesh = data.mesh;
      scene.add(ai.mesh);
    });

    /* ==========================================================================
       5. PARTICLES (TIRE DRIFT SMOKE)
       ========================================================================== */
    const smokeCount = 120;
    const smokeGeo = new THREE.BufferGeometry();
    const smokePos = new Float32Array(smokeCount * 3);
    const smokeOpacities = new Float32Array(smokeCount);
    for (let i = 0; i < smokeCount * 3; i++) smokePos[i] = 0;
    smokeGeo.setAttribute('position', new THREE.BufferAttribute(smokePos, 3));

    const smokeMat = new THREE.PointsMaterial({
      color: 0x8899aa,
      size: 1.2,
      transparent: true,
      opacity: 0.3
    });
    const smokeParticles = new THREE.Points(smokeGeo, smokeMat);
    scene.add(smokeParticles);

    let smokeIdx = 0;
    function addSmokeParticle(x, y, z) {
      smokePos[smokeIdx * 3] = x + (Math.random() - 0.5) * 0.4;
      smokePos[smokeIdx * 3 + 1] = y + 0.15;
      smokePos[smokeIdx * 3 + 2] = z + (Math.random() - 0.5) * 0.4;
      smokeIdx = (smokeIdx + 1) % smokeCount;
      smokeGeo.attributes.position.needsUpdate = true;
    }

    /* ==========================================================================
       6. INPUTS & GARAGE EVENT LISTENERS
       ========================================================================== */
    window.addEventListener('keydown', (e) => {
      initAudio();
      const k = e.key.toLowerCase();
      if (k === 'w' || e.key === 'ArrowUp') keys.w = true;
      if (k === 's' || e.key === 'ArrowDown') keys.s = true;
      if (k === 'a' || e.key === 'ArrowLeft') keys.a = true;
      if (k === 'd' || e.key === 'ArrowRight') keys.d = true;
      if (e.code === 'Space') keys.space = true;
      if (e.key === 'Shift') keys.shift = true;
      if (k === 'g') toggleGarage();
    });

    window.addEventListener('keyup', (e) => {
      const k = e.key.toLowerCase();
      if (k === 'w' || e.key === 'ArrowUp') keys.w = false;
      if (k === 's' || e.key === 'ArrowDown') keys.s = false;
      if (k === 'a' || e.key === 'ArrowLeft') keys.a = false;
      if (k === 'd' || e.key === 'ArrowRight') keys.d = false;
      if (e.code === 'Space') keys.space = false;
      if (e.key === 'Shift') keys.shift = false;
    });

    function toggleGarage() {
      garageOpen = !garageOpen;
      document.getElementById('garage-modal').style.display = garageOpen ? 'flex' : 'none';
    }
    document.getElementById('close-garage').onclick = toggleGarage;

    // Tuning Logik
    document.querySelectorAll('[data-engine]').forEach(btn => {
      btn.onclick = () => {
        document.querySelectorAll('[data-engine]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const type = btn.getAttribute('data-engine');
        if (type === 'stock') { player.maxSpeed = 0.95; player.accel = 0.016; }
        if (type === 'stage2') { player.maxSpeed = 1.15; player.accel = 0.022; }
        if (type === 'apex') { player.maxSpeed = 1.40; player.accel = 0.028; }
      };
    });

    document.querySelectorAll('[data-tires]').forEach(btn => {
      btn.onclick = () => {
        document.querySelectorAll('[data-tires]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const type = btn.getAttribute('data-tires');
        if (type === 'street') player.driftFactor = 0.91;
        if (type === 'drift') player.driftFactor = 0.84;
        if (type === 'racing') player.driftFactor = 0.96;
      };
    });

    document.querySelectorAll('[data-underglow]').forEach(swatch => {
      swatch.onclick = () => {
        document.querySelectorAll('[data-underglow]').forEach(s => s.classList.remove('active'));
        swatch.classList.add('active');
        const col = swatch.getAttribute('data-underglow');
        player.underglow.color.set(col);
      };
    });

    /* ==========================================================================
       7. CHECKPOINTS & LAP TIMING
       ========================================================================== */
    const numCheckpoints = trackPoints.length;
    function checkPlayerLapProgress() {
      // Nächster Checkpoint auf der Strecke
      let nextCp = (player.lastCheckpoint + 1) % numCheckpoints;
      let targetPt = trackPoints[nextCp];
      let dist = player.pos.distanceTo(targetPt);

      if (dist < 22) {
        player.lastCheckpoint = nextCp;
        if (nextCp === 0) {
          // Runde abgeschlossen
          const lapTime = (performance.now() - player.lapStartTime) / 1000;
          if (!player.bestLapTime || lapTime < player.bestLapTime) {
            player.bestLapTime = lapTime;
            document.getElementById('best-timer').innerText = formatTime(lapTime);
          }
          player.lap++;
          player.lapStartTime = performance.now();
          document.getElementById('lap-current').innerText = Math.min(player.lap, 3);
        }
      }
    }

    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      const ms = Math.floor((sec % 1) * 100);
      return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;
    }

    /* ==========================================================================
       8. MINIMAP LOGIC
       ========================================================================== */
    const minimapCanvas = document.getElementById('minimap');
    const ctx = minimapCanvas.getContext('2d');
    minimapCanvas.width = 150;
    minimapCanvas.height = 150;

    function drawMinimap() {
      ctx.clearRect(0, 0, 150, 150);
      ctx.fillStyle = '#101522';
      ctx.fillRect(0, 0, 150, 150);

      // Strecke zeichnen
      ctx.strokeStyle = '#2b3955';
      ctx.lineWidth = 6;
      ctx.beginPath();
      trackPoints.forEach((pt, idx) => {
        let mx = 75 + pt.x * 0.45;
        let my = 75 + pt.z * 0.45;
        if (idx === 0) ctx.moveTo(mx, my);
        else ctx.lineTo(mx, my);
      });
      ctx.closePath();
      ctx.stroke();

      // KI-Punkte
      aiCars.forEach(ai => {
        let mx = 75 + ai.mesh.position.x * 0.45;
        let my = 75 + ai.mesh.position.z * 0.45;
        ctx.fillStyle = '#' + ai.color.toString(16).padStart(6, '0');
        ctx.beginPath();
        ctx.arc(mx, my, 3.5, 0, Math.PI * 2);
        ctx.fill();
      });

      // Spieler-Punkt
      let px = 75 + player.pos.x * 0.45;
      let py = 75 + player.pos.z * 0.45;
      ctx.fillStyle = '#00f0ff';
      ctx.beginPath();
      ctx.arc(px, py, 4.5, 0, Math.PI * 2);
      ctx.fill();
    }

    /* ==========================================================================
       9. MAIN SIMULATION & GAME LOOP
       ========================================================================== */
    let lastTime = performance.now();

    function update() {
      requestAnimationFrame(update);
      const now = performance.now();
      const dt = Math.min((now - lastTime) / 1000, 0.1);
      lastTime = now;

      if (!garageOpen) {
        // --- 1. SPIELER-PHYSIK & HANDLING ---
        let nitroBoost = 1.0;
        if (keys.shift && player.nitro > 0 && keys.w) {
          nitroBoost = 1.45;
          player.nitro = Math.max(0, player.nitro - 28 * dt);
        } else {
          player.nitro = Math.min(100, player.nitro + 10 * dt);
        }
        document.getElementById('nitro-fill').style.height = `${player.nitro}%`;

        // Beschleunigung / Bremsen
        if (keys.w) player.speed += player.accel * nitroBoost;
        else if (keys.s) player.speed -= player.accel * 1.2;
        else player.speed *= 0.982; // Rollwiderstand

        player.speed = Math.max(-0.3, Math.min(player.speed, player.maxSpeed * nitroBoost));

        // Lenkung
        let effectiveSteer = 2.4;
        if (keys.space) effectiveSteer = 3.6; // Handbremse erleichtert Drehung
        if (Math.abs(player.speed) > 0.05) {
          const dir = player.speed >= 0 ? 1 : -1;
          if (keys.a) player.rotY += effectiveSteer * dt * dir;
          if (keys.d) player.rotY -= effectiveSteer * dt * dir;
        }

        // Vektor-Drift-Physik
        const fwd = new THREE.Vector3(Math.sin(player.rotY), 0, Math.cos(player.rotY));
        const side = new THREE.Vector3(fwd.z, 0, -fwd.x);

        const currentForwardVel = fwd.clone().multiplyScalar(player.speed);
        let driftSlip = keys.space ? (player.driftFactor * 0.88) : player.driftFactor;

        player.velocity.lerp(currentForwardVel, 1.0 - driftSlip);
        player.pos.add(player.velocity);

        // Drift-Erkennung
        const lateralSpeed = Math.abs(player.velocity.dot(side));
        player.isDrifting = lateralSpeed > 0.12 && Math.abs(player.speed) > 0.35;

        // Position & Neigung der Karosserie
        player.mesh.position.copy(player.pos);
        player.mesh.rotation.y = player.rotY;

        // Leichtes Kippen (Body Roll) in Kurven
        let rollTarget = (keys.a ? 0.08 : 0) - (keys.d ? 0.08 : 0);
        player.mesh.rotation.z = THREE.MathUtils.lerp(player.mesh.rotation.z, rollTarget, 0.1);

        // Drift Rauchpartikel
        if (player.isDrifting || (keys.shift && keys.w)) {
          const rearLeft = player.pos.clone().add(side.clone().multiplyScalar(-0.9)).add(fwd.clone().multiplyScalar(-1.7));
          const rearRight = player.pos.clone().add(side.clone().multiplyScalar(0.9)).add(fwd.clone().multiplyScalar(-1.7));
          addSmokeParticle(rearLeft.x, rearLeft.y, rearLeft.z);
          addSmokeParticle(rearRight.x, rearRight.y, rearRight.z);
        }

        // --- 2. AUDIO SYNTHESE UPDATES ---
        if (audioCtx && engineOsc) {
          const speedRatio = Math.abs(player.speed) / player.maxSpeed;
          engineOsc.frequency.setValueAtTime(55 + speedRatio * 180, audioCtx.currentTime);
          if (skidGain) {
            skidGain.gain.setValueAtTime(player.isDrifting ? 0.18 : 0.0, audioCtx.currentTime);
          }
        }

        // --- 3. KI GEGNER SIMULATION ---
        aiCars.forEach(ai => {
          ai.splineT = (ai.splineT + dt * 0.024 * ai.speedOffset) % 1.0;
          const posOnTrack = trackCurve.getPointAt(ai.splineT);
          const tangent = trackCurve.getTangentAt(ai.splineT).normalize();
          const normal = new THREE.Vector3(-tangent.z, 0, tangent.x);

          ai.mesh.position.copy(posOnTrack).add(normal.multiplyScalar(ai.offsetTrack));
          ai.mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 0, 1), tangent);
        });

        // --- 4. RUNDEN-ZEITEN & TELEMETRIE ---
        checkPlayerLapProgress();
        const currentLapTime = (performance.now() - player.lapStartTime) / 1000;
        document.getElementById('lap-timer').innerText = formatTime(currentLapTime);

        const kmh = Math.round(Math.abs(player.speed) * 190);
        document.getElementById('speed-val').innerText = kmh;

        // --- 5. KAMERA LOOK-AHEAD VERFOLGUNG ---
        const camDistance = 24;
        const camHeight = 28;
        const lookAhead = fwd.clone().multiplyScalar(10);
        const desiredCamPos = player.pos.clone().add(new THREE.Vector3(0, camHeight, -camDistance));
        camera.position.lerp(desiredCamPos, 0.08);
        camera.lookAt(player.pos.clone().add(lookAhead));

        drawMinimap();
      }

      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // Start
    requestAnimationFrame(update);
  </script>
</body>
</html>
